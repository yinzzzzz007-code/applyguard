digraph Sequence {
  graph [rankdir=TB, bgcolor="#FFFFFF", pad="0.25", nodesep="0.3", ranksep="0.35", fontname="Arial"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#25344A", fillcolor="#F4F6F8", fontcolor="#172033"];
  edge [color="#65758B", penwidth=1.5, arrowsize=0.75, fontname="Arial", fontsize=10];
  start [label="Applicant enters JD and chooses stored experience", fillcolor="#E9EFF7"];
  parse [label="Orchestrator requests Parsed JD"];
  match [label="Matcher returns ranked evidence with rationale"];
  draft [label="Selector drafts claims with evidence IDs"];
  verify [label="Validator returns VERIFIED / NEEDS_REVIEW / BLOCKED", fillcolor="#FCEAEC", color="#9F1D2E"];
  map [label="Mapper prepares simulated ATS fields"];
  check [label="Risk Check exposes unsupported or missing fields", fillcolor="#FCEAEC", color="#9F1D2E"];
  decision [label="Applicant confirms, edits, or cancels", shape=diamond, fillcolor="#FFF4DA", color="#A36B00"];
  audit [label="Audit Record stores trace and decision", fillcolor="#EEF5EC"];
  start -> parse -> match -> draft -> verify -> map -> check -> decision -> audit;
  decision -> draft [label="edit", color="#A36B00", fontcolor="#A36B00"];
}

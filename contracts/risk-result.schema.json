{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://applyguard.local/contracts/risk-result.schema.json",
  "title": "Risk Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["application_id", "risk_level", "risks", "requires_human_confirmation"],
  "properties": {
    "application_id": {"type": "string"},
    "risk_level": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "BLOCK"]},
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk_id", "type", "severity", "message", "related_claim_ids", "mitigation"],
        "properties": {
          "risk_id": {"type": "string"},
          "type": {"type": "string", "enum": ["UNSUPPORTED_CLAIM", "CONFLICT", "MISSING_FIELD", "PRIVACY", "OTHER"]},
          "severity": {"type": "string", "enum": ["INFO", "WARNING", "ERROR"]},
          "message": {"type": "string"},
          "related_claim_ids": {"type": "array", "items": {"type": "string"}},
          "mitigation": {"type": "string"}
        }
      }
    },
    "requires_human_confirmation": {"type": "boolean"}
  }
}


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://applyguard.local/contracts/experience.schema.json",
  "title": "Experience",
  "type": "object",
  "additionalProperties": false,
  "required": ["experience_id", "candidate_id", "organization", "role", "summary", "skills", "claims", "evidence_sources", "verification_state"],
  "properties": {
    "experience_id": {"type": "string", "pattern": "^exp_[a-zA-Z0-9_]+$"},
    "candidate_id": {"type": "string", "pattern": "^cand_[a-zA-Z0-9_]+$"},
    "organization": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "start_date": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "end_date": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "summary": {"type": "string", "minLength": 1},
    "skills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "evidence_ids"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^claim_[a-zA-Z0-9_]+$"},
          "text": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "type", "description"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^ev_[a-zA-Z0-9_]+$"},
          "type": {"type": "string", "enum": ["REPOSITORY", "DOCUMENT", "CERTIFICATE", "REFERENCE", "OTHER"]},
          "description": {"type": "string", "minLength": 1},
          "uri": {"type": ["string", "null"]}
        }
      }
    },
    "verification_state": {"type": "string", "enum": ["UNVERIFIED", "PARTIALLY_VERIFIED", "VERIFIED"]}
  }
}


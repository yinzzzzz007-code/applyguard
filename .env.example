APPLYGUARD_HOST=127.0.0.1
APPLYGUARD_PORT=8000
APPLYGUARD_LOG_LEVEL=INFO
# DeepSeek OpenAI-compatible Chat Completions (https://api-docs.deepseek.com/)
APPLYGUARD_AI_BASE_URL=https://api.deepseek.com
APPLYGUARD_AI_MODEL=deepseek-flash
APPLYGUARD_AI_MAX_TOKENS=2048
APPLYGUARD_AI_TIMEOUT=60
# thinking auto-disabled for DeepSeek; set enabled only if you need reasoning
# APPLYGUARD_AI_THINKING=disabled
APPLYGUARD_AI_API_KEY=

# Optional SAG auxiliary retrieval (off by default; source must be indexed in local SAG).
# APPLYGUARD_SAG_MODE=shadow
# APPLYGUARD_SAG_BASE_URL=http://127.0.0.1:8001
# APPLYGUARD_SAG_SOURCE_ID=
# APPLYGUARD_SAG_TOKEN=
# APPLYGUARD_SAG_TIMEOUT=8
# APPLYGUARD_SAG_MAPPING_PATH=data/local/sag-evidence-map.json
